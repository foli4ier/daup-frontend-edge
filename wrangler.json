{
  "$schema": "./daup-frontend-edge/node_modules/wrangler/config-schema.json",
  "name": "daup-frontend-edge",
  "main": "./daup-frontend-edge/src/worker.ts",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./daup-frontend-edge/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "app.daup.co.za",
      "custom_domain": true
    }
  ]
}
