# On-prem seednode operator pack (v0)
# Copy to .env in this folder:  cp .env.example .env
# start-house loads this file, then runs npm run start:home from the repo root.
# Do not commit .env.

PORT=8080
HOST=0.0.0.0

# Absolute durable LevelDB directory (required for v0).
# Not the repo, not a temp folder, not process.cwd().
# Unix:    /home/you/daup/daup-mcp-data
# Windows: C:\Users\you\daup\daup-mcp-data
# If left empty, start-house uses $HOME/daup/daup-mcp-data (Unix)
# or %USERPROFILE%\daup\daup-mcp-data (Windows).
DAUP_DATA_DIR=

# DATABASE_URL is parked for this pack. Leave unset so the house node
# uses LevelDB at DAUP_DATA_DIR. Postgres remains available on the
# Kortrijk start:home path but is out of scope for v0 on-prem.
# DATABASE_URL=

# Optional: healthcheck also calls tools/call seednode_status when set.
# COMPANY_ID=
# OWNER_EMAIL=

# Optional Cloudflare named tunnel (start-tunnel). Placeholders only.
# CLOUDFLARE_TUNNEL_ID=REPLACE_TUNNEL_ID
# CLOUDFLARE_HOSTNAME=mcp.example.com
# CLOUDFLARE_CREDENTIALS_FILE=
# TUNNEL_LOCAL_URL=http://127.0.0.1:8080
