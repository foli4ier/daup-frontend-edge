# DAUP Ecosystem Cross-App Port & URL Configuration Template
VITE_APP_EDGE_URL=http://localhost:3000
# House MCP base (Hub appends /mcp). Production default is https://mcp.daup.co.za
VITE_APP_MCP_URL=http://localhost:8080
# House seed origin for OTP challenge, place session, and redeem.
# Vite name is VITE_HOUSE_SEED_URL. Ops/Worker name for the same origin is HOUSE_SEED_URL.
# Production: https://mcp.daup.co.za. Do not put a signing secret in this file.
VITE_HOUSE_SEED_URL=https://mcp.daup.co.za
VITE_APP_EATERY_URL=https://eatery.daup.co.za/
VITE_APP_EATOUT_URL=https://eatout.daup.co.za
VITE_APP_RESELLER_URL=http://localhost:3006
VITE_APP_FARMER_URL=http://localhost:3007
VITE_APP_MANUFACTURING_URL=http://localhost:3008
VITE_APP_MANUFACTURER_URL=http://localhost:3008

# Paystack (South Africa, ZAR). Names only — do not commit a key.
# Server secret. Worker: wrangler secret put PAYSTACK_SECRET_KEY
# Local Worker: daup-frontend-edge/.dev.vars (gitignored). Vite reads the same name.
# Never prefix it with VITE_. The browser does not get this value.
PAYSTACK_SECRET_KEY=
# Optional. Checkout uses the authorization URL from initialize, so the hub does not need it.
PAYSTACK_PUBLIC_KEY=
